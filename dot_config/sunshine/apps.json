{
  "apps": [
    {
      "auto-detach": true,
      "exclude-global-prep-cmd": false,
      "exit-timeout": 5,
      "image-path": "desktop.png",
      "name": "Desktop",
      "wait-all": true
    },
    {
      "auto-detach": true,
      "detached": [
        "setsid steam steam://open/bigpicture"
      ],
      "exclude-global-prep-cmd": false,
      "exit-timeout": 5,
      "image-path": "steam.png",
      "name": "Steam Big Picture",
      "prep-cmd": [
        {
          "do": "",
          "undo": "steam steam://close/bigpicture"
        }
      ],
      "wait-all": true
    },
    {
      "auto-detach": true,
      "detached": [
        "setsid env LUTRIS_SKIP_INIT=1 lutris lutris:rungameid/2"
      ],
      "exclude-global-prep-cmd": false,
      "exit-timeout": 5,
      "image-path": "/home/samhl/.config/sunshine/covers/diablo-iv.png",
      "name": "Diablo IV",
      "wait-all": true
    },
    {
      "name": "Monitors Off",
      "image-path": "/home/samhl/.config/sunshine/covers/monitors-off.png",
      "auto-detach": true,
      "exclude-global-prep-cmd": false,
      "exit-timeout": 5,
      "wait-all": true,
      "prep-cmd": [
        {
          "do": "/home/samhl/.config/sunshine/monitors-off.fish",
          "undo": ""
        }
      ]
    },
    {
      "name": "Monitors On",
      "image-path": "/home/samhl/.config/sunshine/covers/monitors-on.png",
      "auto-detach": true,
      "exclude-global-prep-cmd": false,
      "exit-timeout": 5,
      "wait-all": true,
      "prep-cmd": [
        {
          "do": "/home/samhl/.config/sunshine/monitors-on.fish",
          "undo": ""
        }
      ]
    }
  ],
  "env": {
    "PATH": "$(PATH):$(HOME)/.local/bin"
  }
}
