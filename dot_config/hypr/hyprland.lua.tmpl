-- Hyprland Lua config, migrated from hyprland.conf
-- Refer to the wiki: https://wiki.hypr.land/Configuring/Start/


------------------
---- MONITORS ----
------------------
{{- if eq .chezmoi.hostname "sam-x1" }}

hl.monitor({ output = "", mode = "preferred", position = "auto", scale = 1.07 })

{{- else if eq .chezmoi.hostname "SamPC" }}

-- Left Monitor: BenQ 1080p (Rotated Portrait + 180 deg flip)
-- Physically HDMI-A-2. Positioned at the far left origin (0x0).
hl.monitor({ output = "HDMI-A-2", mode = "1920x1080@60",  position = "0x0",    scale = 1, transform = 1 })

-- Center Monitor: ASUS PG42UQ 4K (Main Landscape)
-- Placed right after the left screen's width (at 1080x0).
hl.monitor({ output = "DP-2",     mode = "3840x2160@120", position = "1080x0", scale = 1 })

-- Right Monitor: BenQ 1080p (Rotated Portrait + 180 deg flip)
-- Physically DP-1. Placed at 4920x0.
hl.monitor({ output = "DP-1",     mode = "1920x1080@120", position = "4920x0", scale = 1, transform = 3 })


-------------------------
---- WORKSPACE RULES ----
-------------------------

-- Bind workspaces to specific monitors
hl.workspace_rule({ workspace = "1", monitor = "DP-2",     default = true })
hl.workspace_rule({ workspace = "2", monitor = "HDMI-A-2", default = true })
hl.workspace_rule({ workspace = "3", monitor = "DP-1",     default = true })
{{- end }}


