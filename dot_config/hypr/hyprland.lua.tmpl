---- KEYBINDINGS ----
---------------------

local mainMod = "SUPER" -- Sets "Windows" key as main modifier

local function bind(keys, dispatcher, description, opts)
    opts = opts or {}
    opts.description = description
    return hl.bind(keys, dispatcher, opts)
end

bind(mainMod .. " + slash", hl.dsp.exec_cmd("hyprbind"),                          "Hyprbind (You are here)")
bind(mainMod .. " + grave", hl.dsp.exec_cmd(terminal),                            "Launch terminal")
bind(mainMod .. " + Q",     hl.dsp.window.close(),                                "Kill active window")
bind(mainMod .. " + E",     hl.dsp.exec_cmd(terminal .. " -e " .. fileManager),   "Open file manager")
bind(mainMod .. " + V",     hl.dsp.window.float({ action = "toggle" }),           "Toggle floating")
bind(mainMod .. " + R",     hl.dsp.exec_cmd(menu),                                "Open menu")
bind(mainMod .. " + P",     hl.dsp.window.pseudo(),                               "Toggle pseudotile")   -- dwindle
bind(mainMod .. " + J",     hl.dsp.layout("togglesplit"),                         "Toggle split layout") -- dwindle
bind(mainMod .. " + L",     hl.dsp.exec_cmd("hyprlock"),                          "Lock screen", { release = true })
bind(mainMod .. " + L",     hl.dsp.exec_cmd("command -v hyprshutdown >/dev/null 2>&1 && hyprshutdown || hyprctl dispatch 'hl.dsp.exit()'"),
                                                                                  "Logout (long press)", { long_press = true })
bind(mainMod .. " + A",     hl.dsp.exec_cmd("firefox --new-window google.com/ai"), "Firefox - Google AI")
bind("Print",               hl.dsp.exec_cmd("grimblast copysave area"),           "Take a screenshot of a window or an area")

-- Move focus / active window with mainMod (+ SHIFT) + arrow keys
for _, dir in ipairs({ "left", "right", "up", "down" }) do
    bind(mainMod .. " + " .. dir,         hl.dsp.focus({ direction = dir }),       "Focus " .. dir)
    bind(mainMod .. " + SHIFT + " .. dir, hl.dsp.window.move({ direction = dir }), "Move active window " .. dir)
end

-- Switch workspaces with mainMod + [0-9]
-- Move active window to a workspace with mainMod + SHIFT + [0-9]
for i = 1, 10 do
    local key = i % 10 -- 10 maps to key 0
    bind(mainMod .. " + " .. key,         hl.dsp.focus({ workspace = i }),       "Switch to workspace " .. i)
    bind(mainMod .. " + SHIFT + " .. key, hl.dsp.window.move({ workspace = i }), "Move window to workspace " .. i)
end

-- Example special workspace (scratchpad)
bind(mainMod .. " + S",         hl.dsp.workspace.toggle_special("magic"),            "Toggle scratchpad")
bind(mainMod .. " + SHIFT + S", hl.dsp.window.move({ workspace = "special:magic" }), "Move active to scratchpad")

-- Scroll through existing workspaces with mainMod + scroll
bind(mainMod .. " + mouse_down", hl.dsp.focus({ workspace = "e+1" }), "Next workspace")
bind(mainMod .. " + mouse_up",   hl.dsp.focus({ workspace = "e-1" }), "Previous workspace")

-- Move/resize windows with mainMod + LMB/RMB and dragging
bind(mainMod .. " + mouse:272", hl.dsp.window.drag(),   "Move window with LMB",   { mouse = true })
bind(mainMod .. " + mouse:273", hl.dsp.window.resize(), "Resize window with RMB", { mouse = true })

-- Laptop multimedia keys for volume and LCD brightness
bind("XF86AudioRaiseVolume",  hl.dsp.exec_cmd("wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+"), "Raise volume",        { locked = true, repeating = true })
bind("XF86AudioLowerVolume",  hl.dsp.exec_cmd("wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"),      "Lower volume",        { locked = true, repeating = true })
bind("XF86AudioMute",         hl.dsp.exec_cmd("wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"),     "Toggle mute",         { locked = true, repeating = true })
bind("XF86AudioMicMute",      hl.dsp.exec_cmd("wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"),   "Toggle mic mute",     { locked = true, repeating = true })
bind("XF86MonBrightnessUp",   hl.dsp.exec_cmd("brightnessctl -e4 -n2 set 5%+"),                  "Increase brightness", { locked = true, repeating = true })
bind("XF86MonBrightnessDown", hl.dsp.exec_cmd("brightnessctl -e4 -n2 set 5%-"),                  "Decrease brightness", { locked = true, repeating = true })

-- Requires playerctl
bind("XF86AudioNext",  hl.dsp.exec_cmd("playerctl next"),       "Next track", { locked = true })
bind("XF86AudioPause", hl.dsp.exec_cmd("playerctl play-pause"), "Play/pause", { locked = true })
bind("XF86AudioPlay",  hl.dsp.exec_cmd("playerctl play-pause"), "Play/pause", { locked = true })
bind("XF86AudioPrev",  hl.dsp.exec_cmd("playerctl previous"),   "Previous track", { locked = true })

-- Lock screen on lid close
bind("switch:on:Lid Switch", hl.dsp.exec_cmd("hyprlock"), "Lock screen on lid close", { locked = true })


