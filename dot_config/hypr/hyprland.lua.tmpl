---------------------
---- KEYBINDINGS ----
---------------------

local mainMod = "SUPER"

local function key(k) return mainMod .. " + " .. k end

-- First unused workspace ID (one past the highest existing one)
local function nextEmptyWorkspace()
    local max = 0
    for _, ws in ipairs(hl.get_workspaces()) do
        if ws.id > max then max = ws.id end
    end
    return max + 1
end

hl.bind(key("slash"), hl.dsp.exec_cmd("hyprbind"),                    { description = "Hyprbind (You are here)" })
hl.bind(key("grave"), hl.dsp.exec_cmd(terminal),                      { description = "Launch terminal" })
hl.bind(key("Q"),     hl.dsp.window.close(),                          { description = "Kill active window" })
hl.bind(key("E"),     hl.dsp.exec_cmd(terminal .. " -e " .. fileManager), { description = "Open file manager" })
hl.bind(key("V"),     hl.dsp.window.float({ action = "toggle" }),     { description = "Toggle floating" })
hl.bind(key("R"),     hl.dsp.exec_cmd(menu),                          { description = "Open menu" })
hl.bind(key("P"),     hl.dsp.window.pseudo(),                         { description = "Toggle pseudotile" })
hl.bind(key("J"),     hl.dsp.layout("togglesplit"),                   { description = "Toggle split layout" })
hl.bind(key("L"),     hl.dsp.exec_cmd("hyprlock"),                    { description = "Lock screen", release = true })
hl.bind(key("L"),     hl.dsp.exec_cmd("command -v hyprshutdown >/dev/null 2>&1 && hyprshutdown || hyprctl dispatch 'hl.dsp.exit()'"),
                                                                      { description = "Logout (long press)", long_press = true })
hl.bind(key("A"),     hl.dsp.exec_cmd("firefox --new-window google.com/ai"), { description = "Firefox - Google AI" })
hl.bind("PRINT",      hl.dsp.exec_cmd("hyprshot -m output"))          -- Full screen
hl.bind("Print",      hl.dsp.exec_cmd("grimblast copysave area"))
hl.bind(key("CTRL + SHIFT + M"), hl.dsp.exec_cmd("~/.config/hypr/scripts/toggle-monitors.fish"),
                                                                      { description = "Toggle all monitors on/off", locked = true })

-- Move focus with mainMod + arrow keys
-- Move active window with mainMod + SHIFT + arrow keys
for _, dir in ipairs({ "left", "right", "up", "down" }) do
    hl.bind(key(dir),              hl.dsp.focus({ direction = dir }),       { description = "Focus " .. dir })
    hl.bind(key("SHIFT + " .. dir), hl.dsp.window.move({ direction = dir }), { description = "Move active window " .. dir })
end

-- Switch workspaces with mainMod + [0-9]
-- Move active window to a workspace with mainMod + SHIFT + [0-9]
for i = 1, 10 do
    local k = i % 10 -- 10 maps to key 0
    hl.bind(key(k),              hl.dsp.focus({ workspace = i }),       { description = "Switch to workspace " .. i })
    hl.bind(key("SHIFT + " .. k), hl.dsp.window.move({ workspace = i }), { description = "Move window to workspace " .. i })
end

-- Switch to first empty workspace, or move active window there
hl.bind(key("N"), function()
    hl.dispatch(hl.dsp.focus({ workspace = nextEmptyWorkspace() }))
end, { description = "Switch to first empty workspace on current monitor" })
hl.bind(key("SHIFT + N"), function()
    hl.dispatch(hl.dsp.window.move({ workspace = nextEmptyWorkspace() }))
end, { description = "Move active window to first empty workspace" })

-- Special workspace (scratchpad)
hl.bind(key("S"),         hl.dsp.workspace.toggle_special("magic"),            { description = "Toggle scratchpad" })
hl.bind(key("SHIFT + S"), hl.dsp.window.move({ workspace = "special:magic" }), { description = "Move active to scratchpad" })

-- Scroll through existing workspaces with mainMod + scroll
hl.bind(key("mouse_down"), hl.dsp.focus({ workspace = "e+1" }), { description = "Next workspace" })
hl.bind(key("mouse_up"),   hl.dsp.focus({ workspace = "e-1" }), { description = "Previous workspace" })

-- Move/resize windows with mainMod + LMB/RMB and dragging
hl.bind(key("mouse:272"), hl.dsp.window.drag(),   { mouse = true, description = "Move window with LMB" })
hl.bind(key("mouse:273"), hl.dsp.window.resize(), { mouse = true, description = "Resize window with RMB" })

-- Multimedia keys for volume and brightness
local held = { locked = true, repeating = true }
hl.bind("XF86AudioRaiseVolume",  hl.dsp.exec_cmd("wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+"), held)
hl.bind("XF86AudioLowerVolume",  hl.dsp.exec_cmd("wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"),      held)
hl.bind("XF86AudioMute",         hl.dsp.exec_cmd("wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"),     held)
hl.bind("XF86AudioMicMute",      hl.dsp.exec_cmd("wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"),   held)
hl.bind("XF86MonBrightnessUp",   hl.dsp.exec_cmd("brightnessctl -e4 -n2 set 5%+"),                  held)
hl.bind("XF86MonBrightnessDown", hl.dsp.exec_cmd("brightnessctl -e4 -n2 set 5%-"),                  held)

-- Requires playerctl
hl.bind("XF86AudioNext",  hl.dsp.exec_cmd("playerctl next"),       { locked = true })
hl.bind("XF86AudioPause", hl.dsp.exec_cmd("playerctl play-pause"), { locked = true })
hl.bind("XF86AudioPlay",  hl.dsp.exec_cmd("playerctl play-pause"), { locked = true })
hl.bind("XF86AudioPrev",  hl.dsp.exec_cmd("playerctl previous"),   { locked = true })

-- Lock screen on lid close
hl.bind("switch:on:Lid Switch", hl.dsp.exec_cmd("hyprlock"), { locked = true, description = "Lock screen on lid close" })


--------------------------------
---- WINDOWS AND WORKSPACES ----
--------------------------------

hl.window_rule({
    -- Ignore maximize requests from all apps
    name  = "suppress-maximize-events",
    match = { class = ".*" },

    suppress_event = "maximize",
})

hl.window_rule({
    -- Fix some dragging issues with XWayland
    name  = "fix-xwayland-drags",
    match = {
        class      = "^$",
        title      = "^$",
        xwayland   = true,
        float      = true,
        fullscreen = false,
        pin        = false,
    },

    no_focus = true,
})

hl.window_rule({
    name  = "move-hyprland-run",
    match = { class = "hyprland-run" },

    move  = "20 monitor_h-120",
    float = true,
})

-- D4 only renders half the frame when fullscreened next to other windows,
-- so send it to a fresh workspace on the current monitor (same as SUPER+key)
local d4Moved = {}
local function isolateDiablo(w)
    if w.title ~= "Diablo IV" or d4Moved[w.address] then return end
    d4Moved[w.address] = true
    hl.dispatch(hl.dsp.window.move({ workspace = nextEmptyWorkspace(), window = "address:" .. w.address }))
end
hl.on("window.open",  isolateDiablo)
hl.on("window.title", isolateDiablo)
hl.on("window.close", function(w) d4Moved[w.address] = nil end)

hl.layer_rule({
    name    = "no_anim_for_selection",
    match   = { namespace = "selection" },
    no_anim = true,
})
