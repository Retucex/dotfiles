-------------------
---- AUTOSTART ----
-------------------

hl.on("hyprland.start", function()
    hl.exec_cmd("systemctl --user start hyprpolkitagent")
    hl.exec_cmd("waybar")
    hl.exec_cmd("dunst")
{{- if eq .chezmoi.hostname "SamPC" }}
    hl.exec_cmd("swaybg -o DP-2 -i ~/.config/sukuna-electric.jpg")
    hl.exec_cmd("swaybg -o HDMI-A-2 -i ~/.config/abstract-dark-waves-mirrored.jpg")
    hl.exec_cmd("swaybg -o DP-1 -i ~/.config/abstract-dark-waves.jpg")
{{- else if eq .chezmoi.hostname "sam-x1" }}
    hl.exec_cmd("swaybg -i ~/.config/background.png")
{{- end }}
    hl.exec_cmd("hyprlauncher -d")
    hl.exec_cmd("gnome-keyring-daemon --start --components=secrets")
    hl.exec_cmd("udiskie -t")
    hl.exec_cmd("[ -L ~/media ] || ln -sf /run/media/$USER/ ~/media")
    hl.exec_cmd("fusermount -u -z ~/onedrive || true && rclone mount onedrive: ~/onedrive --vfs-cache-mode full --daemon --log-file=/tmp/rclone.log --log-level DEBUG")
end)


